  robotTargetPosition: {x: 3, y: 0, z: 4}
  learnText:
  - "\u042F \u043D\u0435 \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u043B, \u0447\u0442\u043E
    \u0437\u0434\u0435\u0441\u044C \u043D\u0430\u043F\u0438\u0441\u0430\u0442\u044C"
  - "\u0412\u043E\u0439\u043D\u0430 \u0438 \u043C\u0438\u0440"
  - "\u041E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u043B \u043F\u043E-\u0444\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u0438.
    \u2013 Je ne connais dans la vie que maux bien"
  - "\xABJe ne suis pas un homme de guerre.\xBB"
  - "\xABIl faut vivre, il faut aimer, il faut croire.\xBB"
  - "\xABTout est fini, tout est perdu.\xBB"
  bulbBlink: {fileID: 8714882173323490645}
